  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "expo": "~57.0.18",
    "expo-audio": "~57.0.4",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-secure-store": "~57.0.2",
    "expo-speech-recognition": "^56.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.21",
